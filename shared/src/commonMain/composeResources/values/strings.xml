    <!-- Obfuscation settings -->
    <string name="settings_section_obfuscation">Auto-obfuscation</string>
    <string name="obf_intro">A client-side shell around every protocol (VLESS, VMess, Trojan, Shadowsocks, Hysteria2, WireGuard, AmneziaWG). Its values are regenerated automatically, so traffic doesn\'t keep one recognizable pattern. Nothing has to be changed on the server.</string>
    <string name="obf_enable">Enable obfuscation</string>
    <string name="obf_level">Masking level</string>
    <string name="obf_level_light">Light</string>
    <string name="obf_level_medium">Medium</string>
    <string name="obf_level_strong">Strong</string>
    <string name="obf_methods">Methods</string>
    <string name="obf_tls_fragmentation">TLS split</string>
    <string name="obf_tls_fragmentation_desc">Cuts the handshake into pieces so DPI can\'t read the site name (not used for REALITY)</string>
    <string name="obf_fingerprint">Browser fingerprint</string>
    <string name="obf_fingerprint_desc">Poses as Chrome, Firefox, Safari… — a different one each time</string>
    <string name="obf_quic">QUIC packet size</string>
    <string name="obf_quic_desc">Random first-packet size for Hysteria2 and TUIC</string>
    <string name="obf_headers">HTTP headers</string>
    <string name="obf_headers_desc">Rotates User-Agent for WebSocket / HTTP transports</string>
    <string name="obf_wg_junk">WireGuard junk packets</string>
    <string name="obf_wg_junk_desc">AmneziaWG-style decoys before the handshake — works for plain WireGuard too</string>
    <string name="obf_schedule">Auto-update</string>
    <string name="obf_auto_rotate">New values every 10 min</string>
    <string name="obf_auto_rotate_desc">Used by every new connection and every reconnect</string>
    <string name="obf_auto_reconnect">Reconnect on failure</string>
    <string name="obf_auto_reconnect_desc">If the tunnel drops or goes silent, reconnect right away with fresh values</string>
    <string name="obf_apply_live">Apply new values immediately</string>
    <string name="obf_apply_live_desc">Reconnects every 10 min, briefly interrupting connections</string>
